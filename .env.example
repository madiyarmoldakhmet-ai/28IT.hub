# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration (PostgreSQL local instance)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=local_messenger_db
DB_USER=messenger_user
DB_PASSWORD=secret_local_password

# SQLite Fallback Configuration (If using local SQLite file instead of PostgreSQL)
# DB_DRIVER=sqlite
# DB_SQLITE_FILE=./data/messenger.db

# Authentication / Security
JWT_SECRET=super_secret_jwt_key_change_in_production_123!
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# WebSocket Settings
WS_PORT=3001
WS_HEARTBEAT_INTERVAL=30000
